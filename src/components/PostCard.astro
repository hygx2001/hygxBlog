---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../utils/posts';
import { getAttachmentSizeAttrs } from '../utils/image-size.mjs';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 首屏第一张卡片设 true：急加载 + 高优先级，它通常就是 LCP 元素 */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { title, description, pubDate, category, tags, cover, pinned } = post.data;
const date = pubDate.toISOString().slice(0, 10);
const coverSize = cover ? await getAttachmentSizeAttrs(cover) : {};
---

<article class="pixel-card pixel-card--hover post-card">
  {
    cover && <img
      class="post-card__cover"
      src={`/attachments/${cover}`}
      {...coverSize}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : undefined}
      alt=""
    />
  }
  <div class="post-card__meta">
    {pinned && <span class="pixel-tag pixel-tag--pinned">置顶</span>}
    <time datetime={date}>{date}</time>
    <span>约 {readingTime(post.body)} 分钟</span>
    <a class="pixel-tag" href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
  </div>
  <h2 class="post-card__title">
    <a href={`/blog/${post.id}/`}>{title}</a>
  </h2>
  {description && <p class="post-card__desc">{description}</p>}
  <div class="post-card__footer">
    {
      tags.length > 0 && (
        <div class="post-card__tags">
          {tags.map((tag) => (
            <a class="pixel-tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
          ))}
        </div>
      )
    }
    <a class="post-card__more" href={`/blog/${post.id}/`}>READ &gt;&gt;</a>
  </div>
</article>
