---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, countBy, PAGE_SIZE } from '../utils/posts';
import { SITE_DESCRIPTION } from '../consts';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, PAGE_SIZE);
const hasMorePosts = posts.length > PAGE_SIZE;
const categoryCount = countBy(posts, (p) => [p.data.category]).length;
const tagCount = countBy(posts, (p) => p.data.tags).length;
---

<BaseLayout>
  <section class="hero pixel-card">
    <span class="hero__pixels" aria-hidden="true"></span>
    <p class="hero__eyebrow">// #39C5BB</p>
    <h1 class="hero__title">HYGX<span class="accent">BLOG</span></h1>
    <p class="hero__desc">{SITE_DESCRIPTION}——记录一些有趣的东西。</p>
    <div class="hero__actions">
      <a class="pixel-btn" href="#latest">开始阅读 ↓</a>
      <a class="pixel-btn" href="/timeline/">时间轴</a>
      <span class="hero__stats">{posts.length} 篇文章 · {categoryCount} 个分类 · {tagCount} 枚标签</span>
    </div>
  </section>

  <!-- h2 而非 h1：每页只应有一个 h1（上面的站名），否则读屏器的标题导航会失去主次 -->
  <h2 class="page-title" id="latest">最新文章</h2>
  <div class="post-list">
    {latestPosts.map((post, i) => <PostCard post={post} eager={i === 0} />)}
    {posts.length === 0 && <p>还没有文章，去 src/content/blog/ 里写一篇吧。</p>}
  </div>
  {
    hasMorePosts && (
      <nav class="post-pager" aria-label="最新文章分页">
        <span />
        <a class="pixel-btn post-pager__next" href="/blog/page/2/" rel="next">下一页 →</a>
      </nav>
    )
  }
</BaseLayout>
