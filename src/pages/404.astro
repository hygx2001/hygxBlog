---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <div class="not-found pixel-card">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">GAME OVER</h1>
    <p class="not-found__desc">你要找的页面掉进了像素裂缝里。</p>
    <div class="hero__actions">
      <a class="pixel-btn" href="/">→ 回首页复活</a>
      <a class="pixel-btn" href="/timeline/">看看时间轴</a>
    </div>
  </div>
</BaseLayout>
