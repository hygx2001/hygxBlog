---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, countBy } from '../../utils/posts';

const posts = await getPublishedPosts();
const categories = countBy(posts, (p) => [p.data.category]);
---

<BaseLayout title="分类">
  <h1 class="page-title">文章分类</h1>
  <div class="chip-wall">
    {categories.map(([name, list]) => (
      <a class="pixel-card pixel-card--hover chip" href={`/categories/${encodeURIComponent(name)}/`}>
        {name}<span class="count">×{list.length}</span>
      </a>
    ))}
  </div>
</BaseLayout>
