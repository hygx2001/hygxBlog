---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, countBy } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return countBy(posts, (p) => p.data.tags).map(([name, list]) => ({
    params: { tag: name },
    props: { name, list },
  }));
}

const { name, list } = Astro.props;
---

<BaseLayout title={`标签：${name}`}>
  <h1 class="page-title">标签 / #{name}</h1>
  <div class="post-list">
    {list.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
